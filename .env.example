# containerd/.env.example —— 由 run.sh 复制成 .env 并自动填充随机密钥。
# 不要直接改这份模板；本地实值写在 .env（已被 containerd/.gitignore 排除）。
#
# 这份模板是**所有可调旋钮的完整清单**：compose（两份文件）里每一个 ${VAR} 在这里都有一行。
# 想知道某一行的值现在是多少、真的进不进某个容器，别猜，跑：
#     ./run.sh env
# 它按当前这两份 compose 打三件事 —— 每一行落到哪个容器（容器里的变量名与这里不一致时
# 会标出"叫 XXX"或"嵌在 XXX 里"）、compose 会读但你没写的键（走的是模板里注释掉的那个默认值）、
# 以及没有任何服务读的键（**改了不生效**，这一类以前只能靠人记住）。
#
# 键名后面那行 `# ↳` 标的是这个键最终落在哪个容器里：
#   ↳ dh-fay          会进容器进程的环境变量（服务名用容器名的简写）
#   ↳ 不进容器          只被 compose 的 ports / extra_hosts 用，改的是宿主发布而不是容器内环境
#   ↳ run.sh           只有入口脚本读它
# **注释掉的行 = 不写进 .env 的同一条键**：gen_keys.py 是逐字复制本文件的，把注释去掉才会生效；
# 而留着注释时 compose 用 ${VAR:-默认} 里那个默认值，所以注释里写的默认值就是当前行为。

# ---------- 档位 ----------
# prod（缺省）：只发布必要端口，且一律绑在 BIND_ADDR 上；run.sh 还会硬拒
#   BIND_ADDR=0.0.0.0 或某个局域网地址 —— 那等于把 Fay 的管理台、无鉴权的 OpenAI 兼容口
#   和 13306 / 16379 两个管理口一起放出去。
# dev：额外套一层 docker-compose.dev.yml，把 prod 根本不发布的内部口也放出来，并把
#   BIND_ADDR 导成 0.0.0.0 —— 本机每个地址（局域网 / tailscale / 以后新插的网卡）都收，
#   手机和跑 UE 的那台 Windows 直接连，换网卡也不必重起。这一档没有"只开某一个地址"的
#   中间态，要收紧就回 prod。入口是 ./run.sh dev。
#   代价如实写着：数据库与 redis 的管理口在 dev 下同样对同网段开放，防线只剩口令。
# ↳ run.sh（不进容器：它只决定多叠一份 compose 文件）
DH_ENV=prod

# ---------- 端口与发布地址 ----------
# prod 下这个值就是真正的绑定地址（127.0.0.1 = 只有本机能连）；dev 下 run.sh 把它覆盖成
# 0.0.0.0，写在这里的值在那个档位不生效（环境变量优先于 --env-file，正是靠这个次序）。
# 九条端口键全都不进容器：它们只出现在 compose 的 ports: 里，改的是「宿主机哪个地址的哪个口」，
# 容器内部永远是自己的 8080/8000/8010/5000/10095…（复核：./run.sh env 与
# docker compose ... config | grep host_ip）。
# （宿主机 3306/6379 已被既有 mysql/redis 容器占用，所以这里默认用 13306/16379）
# ↳ 不进容器
BIND_ADDR=127.0.0.1
# ↳ 不进容器
FAY_HTTP_PORT=5000
# ↳ 不进容器
FAY_HUMAN_WS_PORT=10002
# ↳ 不进容器
FAY_WEB_WS_PORT=10003
# ↳ 不进容器
BACKEND_PORT=8000
# ↳ 不进容器
ADAPTER_PORT=8010
# CareEcho H5（伙伴方前端的容器侧外壳）。默认 5173 是照他们 README 与 xmov.js 里唯一
# 写死的那个开发地址来的 —— 宿主端口对齐后，"用 http://127.0.0.1:5173 打开"这句话
# 对这套容器同样成立。
# ↳ 不进容器
FRONTEND_PORT=5173
# FunASR 的宿主端口：**只在 dev 档位发布**（见 docker-compose.dev.yml）。
# 生产不直发，走下面那条同源转发。
# ↳ 不进容器
FUNASR_PORT=10095
# Fay 远程音频监听的宿主端口：dev 里映射的是容器内 9001（fay/bootloader.py 的
# 默认 ASR 转发口）。宿主默认给 10199 而不是 9001，因为本机 9001 已被别的常驻服务占用。
# ↳ 不进容器
FAY_BRIDGE_PORT=10199
# 知识库的 MCP 口：同样只在 dev 发布（prod 只在 compose 内网，Fay 按 http://yueshen-rag:8766 打）。
# ↳ 不进容器
# YUESHEN_RAG_PORT=8766
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379

# ---------- 跨机（UE 在另一台电脑上时才需要） ----------
# 本机在局域网里的地址：dev 档位下 run.sh 自动探测，填在这里可以钉死探测结果。
# 它**不决定端口绑在哪**（dev 恒绑 0.0.0.0，见上面档位那段），只喂两处看得见的值：
# banner 里那些 http://<这个地址>:端口 的链接，和 Fay 的 FAY_URL —— 音频地址必须是
# 对端真能取到的那个 IP，写 0.0.0.0 等于把 UE 引向它自己（patches/fay/0007）。
# ↳ run.sh + 嵌在 dh-fay 的 FAY_URL 里、容器内 dh-host/ue-host 两个名字
DH_LAN_IP=
# 跑 UE5.1 编辑器那台机器的地址，只用来给容器一个稳定名字 ue-host（见 compose 的
# x-host-gateway）。当前 UE 只往 :10002 拨进来、Fay 从不外拨，所以留空不影响任何判据。
# ↳ 不进容器（只写容器内的 hosts 名字）
UE_LAN_IP=
# Fay 回给数字人的音频文件地址（UE 拿它去 :5000 取 wav）。留空 = 上游原行为
# （读 system.conf，为空则自动探测本机 IP）；UE 在别的机器上时必须设成那台够得着的地址，
# 例如 http://192.168.1.10:5000。机制见 patches/fay/0007。dev 档位会由 run.sh 自动设。
# ↳ dh-fay
FAY_URL=

# ---------- MySQL ----------
# ↳ dh-mysql；同时以 MYSQL_PASSWORD 这个名字进 dh-backend / dh-backend-test / dh-backend-probe
MYSQL_DB=care_echo_rehab
MYSQL_ROOT_PASSWORD=CHANGE_ME
# 只有 dh-backend-test 那条判据用（它跑在独立库 care_echo_rehab_test 上，
# 免得测试往业务数据里塞脏行）。改它不影响业务库。
# ↳ dh-backend-test（容器里叫 MYSQL_DB）
# MYSQL_TEST_DB=care_echo_rehab_test

# ---------- Redis ----------
# ↳ dh-redis（作为 --requirepass 命令行参数）+ 嵌在三个服务的 REDIS_URL 里
REDIS_PASSWORD=CHANGE_ME

# ---------- 后端鉴权 ----------
# ↳ dh-backend（探针那两组各拿一份同名的）
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- 后端与其他 ----------
# 本地集成栈默认开 debug：/api/v1/auth/dev-login 与 /dev 测试路由只在 debug 下挂载，
# run.sh smoke 与 H5 外壳代持设备身份都靠它 —— 关掉之后每一发问答都会变 502。
# 对外暴露前务必改回 false。dev 档位的 docker-compose.dev.yml 也会显式写 true。
# ↳ dh-backend
DEBUG=true
# ↳ dh-backend
APP_NAME=康养数字人后端
# adapter 给 Fay 的用户名前缀；Fay 以 username 做记忆隔离主键
# ↳ dh-adapter
ADAPTER_USERNAME_PREFIX=elder_
# 上游 config.py 的默认值是开发者本机的 Windows 路径，参考语料（动作库/计划模板/异常规则/
# 随访标准/分级规则）又不在仓库里，所以容器挂一份只读最小样例顶上。一般没理由改 ——
# 改坏了的表现是导入链路与后端的语料自测静默拿不到东西。
# ↳ dh-backend / dh-backend-test / dh-backend-probe
# JSON_DATA_DIR=/app/reference_data

# ---------- 外壳（dh-frontend）那一跳 ----------
# 外壳等后端的上限（秒）。浏览器侧 axios 的 30s 是前端写死的常量，这里调不动它。
# ↳ dh-frontend
CARECHO_UPSTREAM_TIMEOUT=90
# 外壳的同源 WebSocket 转发表：`路径=上游` 逗号分隔。生产就靠这一条把 H5 的
# ws:///funasr-ws 接进 funasr，所以 prod 不需要给 ASR 开宿主端口。
# 上游只来自这张表、不来自客户端给的 path，所以它不是开放代理。
# ↳ dh-frontend
CARECHO_WS_RELAY=/funasr-ws=funasr:10095/
# 转发两侧的空闲上限（秒）：ASR 会话本身有 FUNASR_MAX_SECONDS 兜底，这里只管
# 「页面开着不动」那一段，到点断开、下次按麦克风自动重连。
# ↳ dh-frontend
CARECHO_WS_RELAY_IDLE=180

# ---------- adapter 的两个时限 ----------
# 超时链，自下而上单调变长（本机实测值，不是拍脑袋）：
#   LLM 请求 420s  <  Fay 回复空闲上限 480s  ≤  adapter 500s  <  后端 520s  <  smoke 600s
# 前两个在 compose 的 x-llm-timeouts 里，这两个见 compose 的 adapter / backend 段。
# 依据：这条预算定在对话还落在宿主 ollama 的时候 —— 当时 16GB 显存里有 15.2GB 被占走
#（2026-09-23 复核：占走的主体就是栈外那台对话推理服务自己的 worker，10742/16376 MiB），
# qwen3.5:9b 只有 6% 权重进显存，连不带规划器的上游直出实例一句话都要实测 172~300s。
# 上游默认值（adapter 60 / 后端 30）
# 在这台机器上会在 Fay 出字之前就抢跑，用户只看到「后端说超时」。
# 腾开显存或换小模型后，把这几个数字调小，交互延迟下限也随之下降。
# 注意 adapter < backend 这个方向不能反，否则 adapter 的超时会被后端当成自己的错。
# ↳ dh-adapter
# ADAPTER_MAX_WAIT_SECONDS=500
# 静默判停只是**没看到 patches/fay/0008 那个 <dh-end> 哨兵时**的退路，而且要求此刻手里
# 已经有正文。不能再当"响应速度"调：两阶段协议里「占位句 → 工具执行 → 正式回答」这段
# 静默实测 3~30s，上游那个 2s 会在这里把回答截成半句。
# ↳ dh-adapter
# ADAPTER_SETTLE_SECONDS=8
# ↳ dh-backend（容器里叫 FAY_FORWARD_TIMEOUT_SECONDS）
# FAY_FORWARD_TIMEOUT_SECONDS=520
# embedding 那条预算（compose x-llm-timeouts 里的 EMBEDDING_TIMEOUT / _MAX_RETRIES）
# 是上面那条链之外**唯一会静默降级**的一处：它太小并不报错，而是让
# simulation_engine/gpt_structure.py:294 落回上游的本地伪向量 —— 仿生记忆从此存假坐标，
# 日志只有一行 print。本机实测：ollama 把 qwen3-embedding:0.6b 换入显存要 72.9s，
# 所以曾经设过的 20s 每次都失败；现在给 90s×2 次。探针里 check_embedding() 专盯这条。
# ↳ dh-fay / dh-fay-lite / 三组 Fay 探针
# EMBEDDING_TIMEOUT=90
# EMBEDDING_MAX_RETRIES=1
# 宿主机 Ollama 端口，只给 run.sh 在 smoke 前打印**嵌入**模型的显存驻留比例用
# （Fay 的嵌入用的 http://host.docker.internal:11434 写在 overlay/fay/system.conf 里）。
# 对话不在这台 ollama 上：它由下面的 FAY_GPT_BASE_URL 决定，本机现在指向栈外另一个
# OpenAI 兼容服务，那个口没有 ollama 的 /api/ps，所以这里量不到它的驻留比例。
# ↳ run.sh
# OLLAMA_PORT=11434

# ---------- LLM / embedding 的端点、密钥与模型名 ----------
# 为什么是环境变量而不是改 system.conf：那份文件**被 git 跟踪**，它只能留「在这台机器上
# 能跑起来」的示例值；换端点（宿主 ollama ↔ 栈外另起的一个 OpenAI 兼容服务 —— 本机把对话
# 搬去 :11432 那台 26B 就是这么做的，端点值本身不进仓库）是机器拓扑，
# 写进去就等于把它钉进历史。机制见 patches/fay/0009（端点与密钥）与 0006（模型名），
# compose 侧的透传见 x-llm-endpoint。
# 全部留空 = 逐字等于上游行为（用 system.conf 里那套）。
# ↳ 全进 dh-fay；下面 YUESHEN_EMBED_* 那三条同时以 FAY_EMBEDDING_* 的名字进
#   dh-fay / dh-fay-lite / dh-probe-fay-lite，并以原名进 dh-yueshen-rag。
#   一组键喂两侧是故意的：写进仿生记忆的向量与知识库检索用的向量必须出自同一个模型、
#   同一个端点，分叉的症状是「检索永远命中不到刚灌进去的内容」且不报错。
# FAY_GPT_BASE_URL=
# FAY_GPT_API_KEY=
# FAY_BIG_MODEL_BASE_URL=
# FAY_BIG_MODEL_API_KEY=
# 模型名与端点是**两条独立的覆盖**（0006 与 0009），别只设端点：对端只挂一个模型时
# 它可能不校验 model 字段照答，那时你以为换了模型、其实发的还是 system.conf 里那个名字。
# 本机踩过一次 —— 这两行写在 .env 里但 compose 当时没透传，改了不生效，`./run.sh env`
# 现在就是为了让这类事一眼看得见。
# ↳ dh-fay
# FAY_GPT_MODEL_ENGINE=
# ↳ dh-fay
# FAY_BIG_MODEL_ENGINE=
# ↳ dh-yueshen-rag / dh-fay(叫 FAY_EMBEDDING_MODEL)
# YUESHEN_EMBED_MODEL=qwen3-embedding:0.6b
# ↳ 同上
# YUESHEN_EMBED_BASE_URL=http://host.docker.internal:11434/v1
# ↳ 同上
# YUESHEN_EMBED_API_KEY=sk-fay
# 上游写死 30s（patches/yueshen_rag/0002 才可调）。本机换入 embedding 模型实测要 70s 以上，
# 30s 撞上的表现不是报错，而是 ingest 返回 inserted:0 —— 所以默认给到 3 倍余量。
# ↳ dh-yueshen-rag
# YUESHEN_EMBED_TIMEOUT=180

# ---------- 轻模型实例 dh-fay-lite（只在 ./run.sh test 下起） ----------
# 这个实例存在的理由是「本机显存装得下的那个小模型 + 宿主 ollama」，所以它**刻意不跟
# 主实例共用端点**：主实例的对话端点搬到栈外那台 26B 时，lite 仍然打宿主 ollama，否则就是拿
# qwen2.5:1.5b 去问一台只有大模型的服务 —— 探针会红在模型名上，而红的原因与它要证的
# 「问答链路真的通」毫无关系（2026-09-22 实测：那个端点的 /v1/models 只有一条）。
# 真要让它也走那台服务，才需要设下面这两条。
# ↳ dh-fay-lite 与 dh-fay-lite-probe（容器里叫 FAY_GPT_BASE_URL / FAY_BIG_MODEL_BASE_URL）
# FAY_LITE_GPT_BASE_URL=http://host.docker.internal:11434/v1
# ↳ 同上（容器里叫 FAY_GPT_API_KEY / FAY_BIG_MODEL_API_KEY）
# FAY_LITE_GPT_API_KEY=ollama
# ↳ dh-fay-lite（同时写进容器里的 FAY_GPT_MODEL_ENGINE 与 FAY_BIG_MODEL_ENGINE）
#   探针 dh-fay-lite-probe 也读它，为的是量「lite 实际在用哪个模型」而不是探针自己猜一个。
# FAY_LITE_MODEL_ENGINE=qwen2.5:1.5b

# ---------- FunASR（H5 麦克风那条链） ----------
# 三个模型名与版本一起钉死（paraformer-large 990MB + fsmn-vad + ct-punc 292MB ≈ 1.3GB）。
# 不钉 revision 的话，modelscope 每次启动都做一次「有没有新版」的网络探测，而那次探测
# 被一个裸 except 包着 —— 断网时表现不是报错，是慢。改这四条之一就是换模型，
# 换完第一次启动会重新下载（缓存卷 funasr-cache，见 ./run.sh asr-seed）。
# ↳ dh-funasr
# FUNASR_MODEL=paraformer-zh
# ↳ dh-funasr
# FUNASR_VAD_MODEL=fsmn-vad
# ↳ dh-funasr
# FUNASR_PUNC_MODEL=ct-punc-c
# ↳ dh-funasr
# FUNASR_REVISION=v2.0.4
# 一路录音最长多少秒：超了服务端直接发 final 收工（前端每帧覆盖输入框，
# 无限录下去也没有意义）。也是单会话内存占用的上界开关。
# ↳ dh-funasr
# FUNASR_MAX_SECONDS=60
# 同时在做推理的会话数（模型本身约 2GB，这台机器可用内存约 8GB，所以给 2）。
# ↳ dh-funasr
# FUNASR_MAX_INFLIGHT=2
# 推理线程数。torch 默认会吃满所有核，而本机 CPU 还要给宿主上那些未驻留显存的模型权重用。
# ↳ dh-funasr
# FUNASR_TORCH_THREADS=4
