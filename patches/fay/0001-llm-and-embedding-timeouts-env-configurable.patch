+# containerd 补丁：上游把 LLM 请求的 timeout / max_retries 写死
+# （小模型 timeout=60、max_retries=1；大模型 timeout=120、max_retries=2）。
+# 本机 ollama 的显存被其他常驻服务占满后 qwen3.5:9b 只能
+# 94% CPU 推理，一次回答容易越过 60s，触发「整条请求重发」，回答反而更晚到。
+# 这里只把两个数字换成环境变量可覆盖，**不设置就是上游原来的值**。
+def _llm_request_kwargs(default_timeout: float, default_retries: int) -> Dict[str, Any]:
+    timeout = os.getenv("LLM_REQUEST_TIMEOUT")
+    retries = os.getenv("LLM_REQUEST_MAX_RETRIES")
+    return {
+        "timeout": float(timeout) if timeout else default_timeout,
+        "max_retries": int(retries) if retries else default_retries,
+    }
+
